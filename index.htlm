<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For Tamanna 💖</title>

<style>
body{
margin:0;
padding:0;
height:100vh;
overflow:hidden;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
font-family:Segoe UI;
background:url('photo.jpg') center/cover no-repeat;
color:white;
position:relative;
}

.overlay{
position:absolute;
width:100%;
height:100%;
background:rgba(0,0,0,0.65);
z-index:1;
}

.container{
position:relative;
z-index:3;
padding:20px;
}

h1{
font-size:26px;
margin-bottom:20px;
min-height:60px;
}

button{
padding:12px 25px;
font-size:18px;
border:none;
border-radius:30px;
cursor:pointer;
margin:10px;
transition:0.3s;
}

#yesBtn{
background:#ff4e88;
color:white;
}

#noBtn{
background:#333;
color:white;
position:absolute;
z-index:4;
}

button:hover{
transform:scale(1.1);
}

.heart{
position:absolute;
font-size:20px;
animation:float 6s linear infinite;
color:#ff4e88;
z-index:2;
}

@keyframes float{
0%{bottom:-20px;opacity:1;}
100%{bottom:110%;opacity:0;}
}

.loveLine{
position:absolute;
color:rgba(255,255,255,0.15);
font-size:16px;
white-space:nowrap;
animation:move linear infinite;
z-index:2;
}

@keyframes move{
0%{transform:translateX(-100%);}
100%{transform:translateX(120%);}
}
</style>
</head>

<body>

<div class="overlay"></div>

<div class="container">
<h1 id="text"></h1>
<button id="yesBtn">Yes 💕</button>
<button id="noBtn">No 😢</button>
</div>

<audio id="music" src="song.mp3" autoplay loop muted></audio>

<script>

// FORCE music to start muted instantly
const music=document.getElementById("music");

// Unmute on first interaction (instant sound)
function enableSound(){
music.muted=false;
music.play();
document.removeEventListener("click",enableSound);
}
document.addEventListener("click",enableSound);


// Typing intro
const intro="Tamanna 💖, will you be my Valentine?";
let i=0;
const textEl=document.getElementById("text");

function type(){
if(i<intro.length){
textEl.innerHTML+=intro.charAt(i);
i++;
setTimeout(type,50);
}
}
type();


// Love lines array
const loveLines=[
"I love you more than yesterday but less than tomorrow.",
"You are my favorite notification.",
"Every love song makes sense because of you.",
"You are my safest place.",
"Six years with you feels like six minutes.",
"You are my peace in chaos.",
"I found my forever in you.",
"You are my best decision.",
"I still get butterflies because of you.",
"You are my home.",
"Loving you is my favorite habit.",
"You are my answered prayer.",
"My heart chose you long ago.",
"You are my softest thought.",
"You are my biggest blessing.",
"You make ordinary days magical.",
"I would choose you in every lifetime.",
"You are my dream come true.",
"You are my forever person.",
"You are my strength.",
"You are my calm.",
"You are my happiness.",
"You are my everything.",
"My heart smiles because of you.",
"You are my favorite hello.",
"And my hardest goodbye.",
"I love the way you exist.",
"You make my world brighter.",
"You are my lucky charm.",
"You are my soulmate.",
"You are my sunshine.",
"You are my safe hug.",
"You are my daily motivation.",
"You are my future.",
"You are my comfort.",
"You are my reason.",
"You are my smile.",
"You are my heart.",
"You are my forever Valentine.",
"You are my greatest adventure.",
"You are my sweetest memory.",
"You are my best friend.",
"You are my heartbeat.",
"You are my everything I prayed for.",
"You are my dream girl.",
"You are my destiny.",
"You are my happiness multiplier.",
"You are my favorite person in this universe.",
"You are my today and all my tomorrows.",
"I love you endlessly, Tamanna.",
"Six years down, forever to go.",
"My world begins and ends with you."
];

const yesBtn=document.getElementById("yesBtn");
const noBtn=document.getElementById("noBtn");

let noStage=0;
let runMode=false;

// YES CLICK
yesBtn.onclick=()=>{
document.querySelector(".container").innerHTML=
"<h1 style='font-size:28px;'>Yayyy 💖 I Love You Tamanna Forever 💕</h1>";

startHearts();
startLoveBackground();
};

// NO CLICK LOGIC
noBtn.onclick=()=>{

if(noStage===0){
noBtn.innerText="Are You Sure? 🥺";
noStage=1;
}
else if(noStage===1){
runMode=true;
noStage=2;

setTimeout(()=>{
noBtn.innerText="Please Select Yes 💖";
},15000);
}
};

// RUNNING BUTTON
document.addEventListener("mousemove",()=>{
if(runMode){
const x=Math.random()*(window.innerWidth-120);
const y=Math.random()*(window.innerHeight-60);
noBtn.style.left=x+"px";
noBtn.style.top=y+"px";
}
});

// Hearts animation
function startHearts(){
setInterval(()=>{
let heart=document.createElement("div");
heart.classList.add("heart");
heart.innerHTML="❤";
heart.style.left=Math.random()*100+"%";
document.body.appendChild(heart);
setTimeout(()=>heart.remove(),6000);
},300);
}

// Background floating love lines
function startLoveBackground(){
setInterval(()=>{
let line=document.createElement("div");
line.classList.add("loveLine");
line.innerText=loveLines[Math.floor(Math.random()*loveLines.length)];
line.style.top=Math.random()*100+"%";
line.style.animationDuration=(15+Math.random()*10)+"s";
document.body.appendChild(line);
setTimeout(()=>line.remove(),25000);
},700);
}

</script>

</body>
</html>
